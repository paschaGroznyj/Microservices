DB_HOST=postgres
DB_PORT=5432
DB_USER=
DB_PASSWORD=
DB_NAME=

SECRET_KEY=
ALGORITHM=

KAFKA_BROKER=broker:9092

HF_TOKEN=
EMB_MODEL=ibm-granite/granite-embedding-278m-multilingual

PORT_PM_AGENT=9001
PORT_DB_CONSUMER=9002
PORT_CHROMA_DB=9003
PORT_AUTH_SERVICE=8000
PORT_CHATS_SERVICE=8001
PORT_RAG_SERVICE=8002
PORT_PARSERS_SERVICE=8003
PORT_GATEWAY_PORT=7000

# Публичный адрес веб-редактора (/editor). Подставь реальный домен в .env.
EDITOR_BASE_URL=https://your-domain.example/

PORT_PLUG_AGENT=19001

GIGACHAT_AUTHORIZATION=''
STORAGE_PATH='knowledge_base'
SYNC_INTERVAL_MINUTES=5
ARTICLES_FOLDER ='articles'
METADATA_FOLDER ='metadata'
FAISS_FOLDER ='faiss_index'
DIGESTS_FOLDER ='digests'


OBS_BUCKET=
OBS_OPEN_BUCKET=
OBS_ACCESS_KEY=
OBS_SECRET_KEY=
OBS_REGION=
OBS_ENDPOINT=

IAM_API_KEY=

DIGEST_RECIPIENTS=paymerov1996@mail.ru
#,VAPaymerov@sberbank.ru,mvpostnyakova@sberbank.ru,PISoldatkin@sberbank.ru

# Расписание APScheduler (cron)
# mon,tue,wed,thu,fri,sat,sun или *, mon-fri и т.д.
DIGEST_SCHEDULE_DAY_OF_WEEK=mon
DIGEST_SCHEDULE_HOUR=9
DIGEST_SCHEDULE_MINUTE=0
DIGEST_TIMEZONE=Europe/Moscow

# Включение / отключение автодайджеста
DIGEST_ENABLED=true

# Режим запуска:
# - once       -> однократный запуск для быстрой проверки
# - scheduler  -> постоянный процесс с APScheduler
DIGEST_RUN_MODE=scheduler

# Загружать ли итоговый дайджест в OBS-хранилище
DIGEST_UPLOAD_TO_OBS=true

# Cloud.ru Activity API — фактический расход отдела (условие A бюджета петли)
ACTIVITY_URL=https://grafana.uva-advanced.ru/cloudru-activity
ACTIVITY_TOKEN=
ACTIVITY_DEPARTMENT=cds
# Собственный жёсткий лимит одной петли самоцикла в рублях (условие C)
LOOP_HARD_LIMIT_RUB=500
# TTL кэша Activity-ответа в Redis, сек (панель обновляется ~раз в час)
BUDGET_CACHE_TTL=900

# agent_sandbox: секретный keep-маркер закрепления workspace
# Если в корне workspace лежит файл с этим именем — он НЕ удаляется TTL-очисткой
# бессрочно, пока файл физически лежит (полный иммунитет к TTL).
WORKSPACE_KEEP_MARKER=.ws_hold

# MAX messenger bot (business.max.ru / @MasterBot)
MAX_TOKEN_API=

# MAX TLS (корпоративный MITM-прокси): путь к CA внутри контейнера или отключение верификации
MAX_CA_BUNDLE=
MAX_TLS_INSECURE=
