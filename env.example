# Скопируйте в .env и заполните. Здесь только переменные, которые читает docker-compose.yml.

# ── Порты сервисов (внутри сети compose) ────────────────────────────
PORT_GATEWAY_PORT=7000
PORT_GATEWAY_SIGMA_PORT=7010
PORT_AUTH_SERVICE=8000
PORT_CHATS_SERVICE=8001
PORT_PARSERS_SERVICE=8003
PORT_PM_AGENT=9001

# ── Адреса между сервисами ──────────────────────────────────────────
KAFKA_BROKER=broker:9092
REDIS_URL=redis://redis:6379/0
AGENT_SERVICE_URL=http://agent_service:9001
CHATS_SERVICE_SELF_URL=http://chats_service:8001
SANDBOX_SERVICE_URL=http://agent_sandbox:8005
SEARXNG_BASE_URL=http://searxng:8080
# Внешний IP хоста, на котором песочница публикует порты 18000-18050
GATEWAY_IP=127.0.0.1

# ── PostgreSQL ─────────────────────────────────────────────────────
DB_HOST=postgres
DB_PORT=5432
DB_USER=augent
DB_PASSWORD=change-me
DB_NAME=augent
# Пароль роли пула агента (создаётся схемой postgres/sql)
AGENT_POOL_PASSWORD=change-me

# ── Авторизация ────────────────────────────────────────────────────
SECRET_KEY=change-me-openssl-rand-hex-32
ALGORITHM=HS256
# Ключ шифрования пользовательских секретов: python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
FERNET_KEY=
# Администраторы агента (формат см. agent_service/app/agent/core/config.py)
ADMINS_INFO=

# ── LLM и медиа ────────────────────────────────────────────────────
CLOUD_LLM_ACCESS_KEY=
ROUTER_API_KEY=
ROUTER_API_BASE_URL=https://routerai.ru/api/v1
# Распознавание речи в ботах и мобильном вводе
TG_ASR_PROVIDER=cloud_ru

# ── Мессенджеры ────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TG_DEBUG_TOKEN=
MAX_TOKEN_API=

# ── Веб-редактор (/editor) ─────────────────────────────────────────
# Один домен или карта по gateway: main=https://main.example,sigma=https://sigma.example
EDITOR_BASE_URL=https://your-domain.example/
# Общий секрет agent_sandbox -> gateway для live-обновлений. Пусто = live выключен.
EDITOR_NOTIFY_TOKEN=
EDITOR_NOTIFY_URL=http://api_gateway:7000/internal/editor/notify,http://api_gateway_sigma:7010/internal/editor/notify

# ── Песочница: git и почта ─────────────────────────────────────────
GITHUB_TOKEN=
GITVERSE_TOKEN=
MAIL_HOST=smtp.example.com
MAIL_PORT=993
MAIL_SMTP_PORT=465
MAIL_LOGIN=
MAIL_PASSWORD=
CAPTION_API_PORT=

# ── Почта агента (send_email) ──────────────────────────────────────
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_LOGIN=
SMTP_PASSWORD=

# ── Объектное хранилище (S3-совместимое) ───────────────────────────
OBS_ENDPOINT=https://s3.example.com
OBS_REGION=ru-1
OBS_BUCKET=
OBS_OPEN_BUCKET=
OBS_ACCESS_KEY=
OBS_SECRET_KEY=
STORAGE_PATH=/app/storage
SYNC_INTERVAL_MINUTES=60
ARTICLES_FOLDER=articles
METADATA_FOLDER=metadata
FAISS_FOLDER=faiss
DIGESTS_FOLDER=digests

# ── Плановые рассылки (APScheduler) ────────────────────────────────
DIGEST_ENABLED=false
DIGEST_RUN_MODE=scheduler
DIGEST_RECIPIENTS=user@example.com
DIGEST_SCHEDULE_DAY_OF_WEEK=mon
DIGEST_SCHEDULE_HOUR=9
DIGEST_SCHEDULE_MINUTE=0
DIGEST_TIMEZONE=Europe/Moscow
DIGEST_UPLOAD_TO_OBS=false

# ── Бюджет самоцикла агента ────────────────────────────────────────
ACTIVITY_URL=https://grafana.example/activity
ACTIVITY_TOKEN=
ACTIVITY_DEPARTMENT=team
LOOP_HARD_LIMIT_RUB=200
BUDGET_CACHE_TTL=900

# Задачник: будить агента после фоновой задачи (1/0). На лету: redis SET tasks:autotrigger 0|1
TASK_AUTOTRIGGER=1
# Задачи, завершённые раньше (с), агента уже не будят (рестарт консьюмера, зависший флаг agent:running)
TASK_TRIGGER_MAX_AGE_S=3600
# готовые задачи одного запроса ждут остальные не дольше, с
TASK_BATCH_WAIT_S=600
